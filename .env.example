# ─────────────────────────────────────────────────────────────────────────────
# Attendance Sync Service — environment configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Comma-separated list of Hikvision device IPs.
# You can also specify per-device credentials using "IP:username:password" format.
# Example: DEVICES=10.10.10.166, 10.10.10.128:admin:customPass!
DEVICES=10.10.10.166,10.10.10.128,10.10.10.165,10.10.10.164,10.10.10.162,10.10.10.131

# Global credentials (used if per-device credentials are not specified)
DEVICE_USER=admin
DEVICE_PASS=your_device_password

# Whether to use HTTPS (default: true)
# HIKVISION_USE_HTTPS=true

# Whether to verify SSL certificates (default: false - usually needed for local devices)
# HIKVISION_VERIFY_SSL=false

# Frappe HRMS base URL (no trailing slash)
HRMS_URL=https://hrms.example.com

# Frappe API credentials (Settings → My Account → API Access)
HRMS_API_KEY=your_api_key
HRMS_API_SECRET=your_api_secret

# ── optional tunables ─────────────────────────────────────────────────────────

# Poll interval in seconds (600 = 10 minutes)
# POLL_INTERVAL=600

# How many hours to look back for data when the script starts (default: 24)
# FIRST_RUN_LOOKBACK_HOURS=24

# Duplicate-punch suppression window in seconds (default: 30)
# DEDUP_WINDOW=30

# Event type filter (default: major=5, minors=75,38 — face + fingerprint)
# EVENT_MAJOR=5
# EVENT_MINORS=75,38

# Path to employee map JSON (default: ./employee_map.json)
# EMPLOYEE_MAP=employee_map.json

# SQLite database path (default: ./data/events.db)
# STORE_PATH=data/events.db

# Retry queue settings
# RETRY_MAX_ATTEMPTS=5
# RETRY_BACKOFF_BASE=2.0

# Logging: DEBUG | INFO | WARNING | ERROR (default: INFO)
# LOG_LEVEL=INFO

# Optional log file (default: stdout only)
# LOG_FILE=logs/attendance_sync.log

# ── central server mode ─────────────────────────────────────────────────────

# Run on the central machine with:
# python attendance_sync\server.py
#
# The central server receives signed batches from PC A / PC B and pushes them
# to Frappe manually, or once per day if FRAPPE_AUTO_PUSH_ENABLED=true.
# SERVER_HOST=0.0.0.0
# SERVER_PORT=8080
# SERVER_MAX_CONCURRENT_REQUESTS=4
# SERVER_MAX_HEAVY_REQUESTS=2
# SERVER_MAX_REQUEST_BODY_BYTES=2097152
# SERVER_MAX_EVENT_BATCH_SIZE=500
# PENDING_PROCESS_BATCH_SIZE=250
# POSTGRES_MAX_CONNECTIONS=4
# EMPLOYEE_CACHE_TTL_SECONDS=300
# EMPLOYEE_CACHE_MAX_ENTRIES=1000
# NODE_TRACKER_TTL_SECONDS=86400
# NODE_TRACKER_MAX_ENTRIES=500
# SERVER_NODE_KEYS=pc-a:replace_with_long_random_secret_a,pc-b:replace_with_long_random_secret_b
# FRAPPE_AUTO_PUSH_ENABLED=false
# FRAPPE_AUTO_PUSH_TIME=22:00
# FRAPPE_AUTO_PUSH_TIMEZONE=Asia/Kolkata
# Optional command after Employee Map save. In Docker this needs docker socket access.
# EMPLOYEE_MAP_RESTART_COMMAND=docker restart punch-sync-server

# ── edge PC mode ────────────────────────────────────────────────────────────

# Run on PC A and PC B with:
# python attendance_sync\edge_agent.py
#
# Each PC should use a different EDGE_NODE_ID and matching secret from
# SERVER_NODE_KEYS on the central server.
# SYNC_SERVER_URL=http://central-server-ip:8080
# EDGE_NODE_ID=pc-a
# EDGE_NODE_SECRET=replace_with_long_random_secret_a
# EDGE_BATCH_SIZE=200
# EDGE_REQUEST_TIMEOUT=20

# ── check-in metadata ───────────────────────────────────────────────────────

# Map device IPs to friendly names (live attendance, Frappe push, exports)
# DEVICE_NAMES=10.10.80.50:First Floor IN,10.10.80.51:First Floor OUT,10.10.80.52:Second Floor IN,10.10.80.53:Second Floor OUT,10.10.80.54:Third Floor IN,10.10.80.55:Third Floor OUT

# Default log type (IN/OUT)
# DEFAULT_LOG_TYPE=IN

# HR verification late-coming threshold (local punch time)
# LATE_AFTER_TIME=09:30

# GPS coordinates for check-in records
# LATITUDE=11.2540483
# LONGITUDE=75.8369664
