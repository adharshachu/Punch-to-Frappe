# Copy this file to .env beside docker-compose.yml. Do not commit .env.
# Use immutable tags or, preferably, image digests from the release pipeline.
PUNCH_SYNC_IMAGE=codeaceitsolutionsllp/punch-to-frappe:sha-a6a7ea5
HRMS_ATTENDANCE_IMAGE=codeaceitsolutionsllp/hrms-attendance:sha-dfc70d8

# Required by PostgreSQL, HRMS DATABASE_URL, and the POSTGRES_DSN in
# .env.punch.secrets. Generate a URL-safe random value and keep both identical.
POSTGRES_PASSWORD=replace_me_with_a_long_random_password

# Port 8090 is an emergency/local endpoint and is loopback-only by default.
DASHBOARD_BIND_ADDRESS=127.0.0.1
DASHBOARD_PORT=8090
