# Copy this file to .env.server on the Ubuntu Docker server.
# Do not commit .env.server.
#
# Non-secret runtime settings. Copy to .env.server and keep secrets in the
# separate .env.punch.secrets file. Remote users should
# use HTTPS on port 443;
# port 8090 is bound to loopback by default.
# Only non-secret settings should be edited in the Configuration tab. Edits land
# back in this file; run `docker compose restart punch-sync-server` to apply them.
# Make this file writable by uid 10001 inside the container.
#
HRMS_URL=https://your-frappe-site.example.com

EMPLOYEE_MAP=/app/employee_map.json
STORAGE_BACKEND=postgres

SERVER_HOST=0.0.0.0
SERVER_PORT=8080
FRAPPE_AUTO_PUSH_ENABLED=true
FRAPPE_AUTO_PUSH_TIME=22:00
FRAPPE_AUTO_PUSH_TIMEZONE=Asia/Kolkata
NODE_UPTIME_MONITOR_ENABLED=false
NODE_UPTIME_THRESHOLD_HOURS=8
NODE_UPTIME_CHECK_INTERVAL_SECONDS=1200
NODE_UPTIME_NOTIFY_ON_RECOVERY=true
SLACK_WEBHOOK_URL=
# Container self-restart is intentionally disabled. Restart explicitly from
# the host after saving configuration or employee mappings.
EMPLOYEE_MAP_RESTART_COMMAND=

POLL_INTERVAL=600
DEDUP_WINDOW=30
DEFAULT_LOG_TYPE=IN
LATE_AFTER_TIME=09:30
LOG_LEVEL=INFO
# Leave empty in Docker so logs go to stdout and can be read with docker logs.
LOG_FILE=
